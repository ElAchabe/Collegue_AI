  "pedagogical_suggestions": [
    "Étaler la découverte de l'outil informatique sur plusieurs séances.",
    "Utiliser des schémas illustratifs (constituants d'un ordinateur, touches du clavier).",
    "Ouvrir au besoin une unité centrale pour l'observation.",
    "Appuyer le développement des notions par des démonstrations pratiques.",
    "Éduquer les apprenants à une éthique d'utilisation et à la préservation du matériel."
  ],
  "laboratory_tips": [
    "Binômes homogènes/semi-hétérogènes",
    "Rotation 25 min",
    "Élève tuteur par rangée",
    "Fiche d'aide pas-à-pas + défi pour rapides",
    "Préservation du matériel et sécurité"
  ],
  "didactic_best_practices": [
    "Montrer → Faire → Dire",
    "Textes courts et concrets",
    "Problématiser, éviter le directif passif",
    "Étaler la découverte de l'outil",
    "Petits projets personnels/équipe",
    "Faire déceler et corriger les erreurs"
  ],

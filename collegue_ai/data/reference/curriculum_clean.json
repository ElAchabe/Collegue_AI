{
  "schema_version": 2,
  "institutional_reference": "Instructions Officielles Informatique Collège (2006)",

  "competency_framework": {
    "domains_of_action": [
      { "name": "Culture informatique / Traitement", "competencies": [
        { "code": "C0", "statement": "Maîtriser les technologies de base relatives au fonctionnement d'un système informatique",
          "resources": { "savoir": ["Constituants d'un système informatique","Fonctions de chaque constituant","Notion de logiciel, de fichier et de dossier","Configuration monoposte vs réseau local (LAN, MAN, WAN)"],
          "savoir_faire": ["Distinguer les différents constituants d'un S.I","Connecter les principaux périphériques externes","Schématiser l'architecture fonctionnelle d'un ordinateur","Mettre en marche et éteindre convenablement l'équipement"],
          "savoir_etre": ["Préservation du matériel","Respect strict des consignes de sécurité","Organisation et rigueur"] } },
        { "code": "C11", "statement": "Produire un document Multimédia",
          "resources": { "savoir": ["Utilitaires (dessin, image, son)","Texteur et traitement de texte","Diapositive, diaporama et animations","Hyperliens et multimédia"],
          "savoir_faire": ["Créer et manipuler des fichiers texte, dessin, image et son","Mettre en forme, en page et imprimer un document","Créer un diaporama interactif avec animations","Créer des liens hypertextes et intégrer des objets hétérogènes"],
          "savoir_etre": ["Sens de l'esthétique et créativité","Convivialité et organisation","Esprit de synthèse"] } },
        { "code": "C12", "statement": "Produire un document de calcul",
          "resources": { "savoir": ["Tableur et classeur","Feuille de calcul, cellules et types de données","Adresses relatives vs absolues","Formules, fonctions prédéfinies et graphiques"],
          "savoir_faire": ["Opérer sur une ou plusieurs cellules","Saisir et recopier des formules","Insérer des fonctions prédéfinies","Différencier adressage relatif/absolu","Générer et interpréter un graphique"],
          "savoir_etre": ["Précision et rigueur d'analyse","Capacité d'interprétation","Sens de l'organisation"] } },
        { "code": "C13", "statement": "Produire un programme informatique",
          "resources": { "savoir": ["Notion de programme et de langage (Logo / Blocs)","Primitives et instructions de contrôle (boucles)","Variables et types","Procédures et sous-programmes paramétrés"],
          "savoir_faire": ["Écrire des instructions et primitives","Utiliser des structures de répétition","Déclarer et manipuler des variables","Écrire et réutiliser des procédures paramétrées","Structurer, tester et déboguer"],
          "savoir_etre": ["Rigueur logique et abstraction","Persévérance face à l'erreur","Curiosité algorithmique"] } }
      ]},
      { "name": "Recherche documentaire", "competencies": [
        { "code": "C21", "statement": "Rechercher des informations sur un support de stockage",
          "resources": { "savoir": ["Supports de stockage","Arborescence, dossiers, fichiers, extensions","Explorateur et caractères génériques"],
          "savoir_faire": ["Accéder aux contenus des supports","Naviguer dans une arborescence","Rechercher avec filtres et caractères génériques","Copier, déplacer, renommer des fichiers"],
          "savoir_etre": ["Sens de l'organisation","Gestion ordonnée de l'espace numérique"] } },
        { "code": "C22", "statement": "Rechercher des informations à partir d'un support encyclopédique",
          "resources": { "savoir": ["Encyclopédie numérique hors-ligne","Mots-clés et opérateurs logiques","Hyperliens documentaires"],
          "savoir_faire": ["Consulter une encyclopédie","Formuler des requêtes simples/avancées","Extraire et réinvestir les résultats"],
          "savoir_etre": ["Esprit critique","Capacité d'analyse et de comparaison"] } },
        { "code": "C23", "statement": "Rechercher des informations sur le Web",
          "resources": { "savoir": ["Internet, Web, pages et sites","URL, navigateurs, moteurs et annuaires","Téléchargement et droits d'auteur"],
          "savoir_faire": ["Accéder à un site via URL","Naviguer via hyperliens","Interroger un moteur avec mots-clés","Télécharger et vérifier des ressources"],
          "savoir_etre": ["Sens critique face aux sources","Respect de la propriété intellectuelle"] } }
      ]},
      { "name": "Communication", "competencies": [
        { "code": "C31", "statement": "Exploiter les interfaces graphiques d'un S.E",
          "resources": { "savoir": ["GUI, bureau, fenêtres, menus","Organisation du clavier","Gestion des fichiers et répertoires"],
          "savoir_faire": ["Maîtriser les actions souris","Utiliser le clavier et raccourcis","Manipuler les fenêtres","Créer et organiser dossiers/fichiers"],
          "savoir_etre": ["Autonomie de manipulation","Sens logique et méthode"] } },
        { "code": "C32", "statement": "Échanger des informations via un réseau local",
          "resources": { "savoir": ["Réseau local (LAN) et topologies","Partage de ressources","Partage et droits d'accès"],
          "savoir_faire": ["Explorer dossiers/imprimantes partagés","Partager une ressource","Transférer des fichiers","Utiliser une messagerie locale"],
          "savoir_etre": ["Esprit de collaboration","Respect de la confidentialité"] } },
        { "code": "C33", "statement": "Utiliser la messagerie électronique",
          "resources": { "savoir": ["Email et structure d'adresse","Webmail","Pièces jointes, boîtes de réception"],
          "savoir_faire": ["Créer/configurer une boîte","Composer, envoyer, répondre","Attacher/télécharger des pièces jointes","Gérer sa boîte"],
          "savoir_etre": ["Nétiquette","Vigilance face aux spams"] } }
      ]}
    ]
  },


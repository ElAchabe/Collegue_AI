    "pedagogical_approach": "Approche Par Compétences (APC) et Pédagogie de l'Intégration",
    "cognitive_integration_mechanisms": {
      "interiorisation": {
        "assimilation": "Incorporation directe d'une connaissance, d'une habileté ou d'une attitude.",
        "modelisation": "Mise en relation et coordination des connaissances pour structurer un nouvel ensemble cohérent."
      },
      "exteriorisation": {
        "application": "Mobilisation des acquis assimilés et modélisés dans un contexte concret et familier.",
        "transfert": "Mobilisation d'un ensemble complexe d'acquis dans une situation et un contexte totalement inédits."
      }
    }
  },

  "competencies_taxonomy": {
    "domaines_action": ["Culture informatique / Traitement", "Recherche documentaire", "Communication"],
    "competencies_list": {
      "C0": {
        "domaine": "Culture informatique",
        "intitule": "Maîtriser les technologies de base relatives au fonctionnement d'un système informatique",
        "savoir": ["Constituants d'un système informatique","Fonctions de chaque constituant","Notion de logiciel, de fichier et de dossier","Configuration monoposte vs réseau local (LAN, MAN, WAN)"],
        "savoir_faire": ["Distinguer les différents constituants d'un S.I","Connecter les principaux périphériques externes","Schématiser l'architecture fonctionnelle d'un ordinateur","Mettre en marche et éteindre convenablement l'équipement"],
        "savoir_etre": ["Préservation du matériel","Respect strict des consignes de sécurité","Organisation et rigueur"]
      },
      "C11": {
        "domaine": "Traitement",
        "intitule": "Produire un document Multimédia",
        "savoir": ["Utilitaires (dessin, image, son)","Texteur et traitement de texte","Diapositive, diaporama et animations","Hyperliens et multimédia"],
        "savoir_faire": ["Créer et manipuler des fichiers texte, dessin, image et son","Mettre en forme, en page et imprimer un document","Créer un diaporama interactif avec animations","Créer des liens hypertextes et intégrer des objets hétérogènes"],
        "savoir_etre": ["Sens de l'esthétique et créativité","Convivialité et organisation","Esprit de synthèse"]
      },
      "C12": {
        "domaine": "Traitement",
        "intitule": "Produire un document de calcul",
        "savoir": ["Tableur et classeur","Feuille de calcul, cellules et types de données","Adresses relatives vs absolues","Formules, fonctions prédéfinies et graphiques"],
        "savoir_faire": ["Opérer sur une ou plusieurs cellules","Saisir et recopier des formules","Insérer des fonctions prédéfinies","Différencier adressage relatif/absolu","Générer et interpréter un graphique"],
        "savoir_etre": ["Précision et rigueur d'analyse","Capacité d'interprétation","Sens de l'organisation"]
      },
      "C13": {
        "domaine": "Traitement",
        "intitule": "Produire un programme informatique",
        "savoir": ["Notion de programme et de langage (Logo / Blocs)","Primitives et instructions de contrôle (boucles)","Variables et types","Procédures et sous-programmes paramétrés"],
        "savoir_faire": ["Écrire des instructions et primitives","Utiliser des structures de répétition","Déclarer et manipuler des variables","Écrire et réutiliser des procédures paramétrées","Structurer, tester et déboguer"],
        "savoir_etre": ["Rigueur logique et abstraction","Persévérance face à l'erreur","Curiosité algorithmique"]
      },
      "C21": {
        "domaine": "Recherche",
        "intitule": "Rechercher des informations sur un support de stockage",
        "savoir": ["Supports de stockage","Arborescence, dossiers, fichiers, extensions","Explorateur et caractères génériques"],
        "savoir_faire": ["Accéder aux contenus des supports","Naviguer dans une arborescence","Rechercher avec filtres et caractères génériques","Copier, déplacer, renommer des fichiers"],
        "savoir_etre": ["Sens de l'organisation","Gestion ordonnée de l'espace numérique"]
      },
      "C22": {
        "domaine": "Recherche",
        "intitule": "Rechercher des informations à partir d'un support encyclopédique",
        "savoir": ["Encyclopédie numérique hors-ligne","Mots-clés et opérateurs logiques","Hyperliens documentaires"],
        "savoir_faire": ["Consulter une encyclopédie","Formuler des requêtes simples/avancées","Extraire et réinvestir les résultats"],
        "savoir_etre": ["Esprit critique","Capacité d'analyse et de comparaison"]
      },
      "C23": {
        "domaine": "Recherche",
        "intitule": "Rechercher des informations sur le Web",
        "savoir": ["Internet, Web, pages et sites","URL, navigateurs, moteurs et annuaires","Téléchargement et droits d'auteur"],
        "savoir_faire": ["Accéder à un site via URL","Naviguer via hyperliens","Interroger un moteur avec mots-clés","Télécharger et vérifier des ressources"],
        "savoir_etre": ["Sens critique face aux sources","Respect de la propriété intellectuelle"]
      },
      "C31": {
        "domaine": "Communication",
        "intitule": "Exploiter les interfaces graphiques d'un S.E",
        "savoir": ["GUI, bureau, fenêtres, menus","Organisation du clavier","Gestion des fichiers et répertoires"],
        "savoir_faire": ["Maîtriser les actions souris","Utiliser le clavier et raccourcis","Manipuler les fenêtres","Créer et organiser dossiers/fichiers"],
        "savoir_etre": ["Autonomie de manipulation","Sens logique et méthode"]
      },
      "C32": {
        "domaine": "Communication",
        "intitule": "Échanger des informations via un réseau local",
        "savoir": ["Réseau local (LAN) et topologies","Partage de ressources","Partage et droits d'accès"],
        "savoir_faire": ["Explorer dossiers/imprimantes partagés","Partager une ressource","Transférer des fichiers","Utiliser une messagerie locale"],
        "savoir_etre": ["Esprit de collaboration","Respect de la confidentialité"]
      },
      "C33": {
        "domaine": "Communication",
        "intitule": "Utiliser la messagerie électronique",
        "savoir": ["Email et structure d'adresse","Webmail","Pièces jointes, boîtes de réception"],
        "savoir_faire": ["Créer/configurer une boîte","Composer, envoyer, répondre","Attacher/télécharger des pièces jointes","Gérer sa boîte"],
        "savoir_etre": ["Nétiquette","Vigilance face aux spams"]
      }
    }
  },


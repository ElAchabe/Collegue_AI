  "didactic_methodologies": {
    "problem_based_learning_pbl": {
      "definition": "Confronter l'élève à une situation-problème nécessitant l'acquisition/coordination de ressources.",
      "operational_steps": ["Confrontation au problème","Émergence des questions pendantes","Hiérarchisation et répartition des recherches","Recherche et intégration des connaissances","Synthèse, validation, institutionnalisation"]
    },
    "project_based_pedagogy": {
      "definition": "Projet authentique débouchant sur une production concrète.",
      "four_phases": ["Recherche","Planification","Réalisation","Évaluation"]
    },
    "demonstrative_method": {
      "sequence": ["Montrer","Faire","Dire"]
    },
    "guided_discovery_method": {
      "sequence": ["Faire (tâtonnement)","Dire (explicitation)","Reformulation et cadrage"]
    },
    "interrogative_method": {
      "objective": "Questionnement pour faire émerger les représentations et guider la déduction."
    },
    "expositive_method": {
      "objective": "Exposé bref pour éléments théoriques non déductibles."
    }
  },

  "pedagogical_planning_framework": {
    "three_moments_of_learning": [
      {"moment": "1. Apprentissages ponctuels de ressources", "target": "Acquisition ciblée des savoirs, savoir-faire et attitudes."},
      {"moment": "2. Activités d'intégration", "target": "Mobilisation coordonnée face à une situation-problème ou mini-projet."},
      {"moment": "3. Activités d'évaluation et régulation", "target": "Diagnostic, formative continue et remédiation."}
    ],
    "three_mandatory_preparation_files": {
      "fiche_ressources": {
        "description": "Planifie une séquence d'acquisition de ressources.",
        "template_structure": ["Niveau et unité","Compétence(s) et domaine","Ressources ciblées (S/SF/SE)","Prérequis","Matériel et logistique","Scénario (déclencheur, activités, synthèse)","Différenciation et temps machine"]
      },
      "fiche_integration": {
        "description": "Mobilise plusieurs ressources dans une situation complexe.",
        "template_structure": ["Compétence(s) ciblée(s)","Situation-problème","Consignes opérationnelles","Ressources à mobiliser","Organisation et livrable"]
      },
      "fiche_evaluation": {
        "description": "Évaluation basée sur une situation inédite et critériée.",
        "template_structure": ["Compétence(s) à évaluer","Situation inédite","Grille critériée (minimaux/perfectionnement)","Indicateurs et barème"]
      }
    }
  },

  "evaluation_rules_and_norms": {
    "diagnostic_evaluation": {
      "moment": "Début de cycle/semestre/unité",
      "target": "Identifier acquis et représentations erronées."
    },
    "formative_evaluation": {
      "frequency": "Au moins 2 par semestre",
      "duration": "Maximum 20 minutes",
      "focus": "Maîtrise des ressources pour régulation immédiate.",
      "error_philosophy": "Droit à l'erreur ; point de départ de la remédiation."
    },
    "summative_evaluation": {
      "frequency": "1 par semestre",
      "duration": "Environ 55 minutes",
      "format": "Situation complexe de résolution de problèmes.",
      "criteria_rules": ["Limiter le nombre de critères","Distinguer minimaux/perfectionnement","Vérifier chaque critère 2-3 fois via indicateurs indépendants"]
    }
  },

  "competency_specific_didactic_orientations": {
    "C0_and_C31": ["Étaler la découverte sur plusieurs séances","Angle fonctionnel (pas technologique abstrait)","Schémas illustratifs","Gestes corrects (allumage, souris, posture)"],
    "C11_and_C12": ["Centrer sur l'usage, pas l'interface","Supports courts et concrets","Éviter le pas-à-pas passif","Articuler avec projets concrets"],
    "C13": ["Raisonnement et décomposition avant syntaxe","Créer le besoin avant chaque structure","Modularité et réutilisation","Anticiper et autocorriger (débogage)"],
    "C21_C22_C23": ["Situations réelles interdisciplinaires","Esprit critique sur les sources","Méthodologie de recherche","Droits d'auteur et filtrage"],
    "C32_C33": ["Partage réseau concret","Emails scolaires encadrés","Nétiquette et vigilance"]
  },

  "laboratory_management_guidelines": [
    "Binômes homogènes/semi-hétérogènes",
    "Rotation stricte 25 min clavier/souris",
    "Espace disque dédié par classe/binôme",
    "Cahier de cours avec traces écrites institutionnalisées"
  ],

  "predecessor_teacher_tips": {
    "didactic_best_practices": [
      "Privilégier la méthode démonstrative : Montrer → Faire → Dire.",
      "Imposer des textes courts et concrets pour maximiser la manipulation.",
      "Problématiser les activités ; éviter les ateliers purement directifs.",
      "Étaler la découverte de l'outil sur plusieurs séances.",
      "Envisager de petits projets personnels ou d'équipe.",
      "Inciter les apprenants à déceler leurs erreurs et à les corriger."
    ],
    "laboratory_management": [
      "Binômes homogènes pour les TP dirigés ; semi-hétérogènes pour les projets.",
      "Rotation stricte clavier/souris : 25 min par élève.",
      "Un élève « tuteur » par rangée pour les pannes simples.",
      "Fiche d'aide pas-à-pas pour les élèves en difficulté ; défi supplémentaire pour les rapides.",
      "Éduquer à la préservation du matériel et aux consignes de sécurité."
    ]
  }
